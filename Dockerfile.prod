# BeachRex Frontend — Production Dockerfile (Next.js 14 standalone)
# Requires `output: 'standalone'` in next.config.js (added separately).
# Used by deploy/docker-compose.vps.yml for front_prod / front_stage / front_dev.

# ---------- 1. Build deps ----------
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --ignore-scripts

# ---------- 2. Build ----------
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Env vars needed at BUILD time (public vars are inlined into the build).
# The runtime env_file overrides at container start for non-public vars.
ARG NEXT_PUBLIC_API_ENDPOINT
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_CDN_TEASER
ARG NEXT_PUBLIC_CDN_LARGE
ARG NEXT_PUBLIC_CDN_ASSETS
# Cloudflare Turnstile on the AI chat; empty = off
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_API_ENDPOINT=${NEXT_PUBLIC_API_ENDPOINT}
ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}
ENV NEXT_PUBLIC_CDN_TEASER=${NEXT_PUBLIC_CDN_TEASER}
ENV NEXT_PUBLIC_CDN_LARGE=${NEXT_PUBLIC_CDN_LARGE}
ENV NEXT_PUBLIC_CDN_ASSETS=${NEXT_PUBLIC_CDN_ASSETS}
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY}
ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_ENV_VALIDATION=1
RUN yarn build

# ---------- 3. Runner ----------
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# Copy standalone build output + static assets
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3001
# next start reads PORT env; compose sets PORT per environment (3001/3002/3003)
CMD ["node", "server.js"]
