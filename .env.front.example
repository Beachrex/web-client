# BeachRex Frontend — VPS environment template
# Copy to envs/.env.front.{prod,uat,dev} on the server, or store as a
# GitHub Secret (ENV_PROD_FRONT / ENV_STAGE_FRONT / ENV_DEV_FRONT) and let
# the deploy workflow write it to the server.
#
# Public vars (NEXT_PUBLIC_*) are inlined at BUILD time — they must be set
# as Docker build args (see Dockerfile.prod) and in this env file for runtime.
# Non-public vars are read at runtime only.

# --- API endpoint this frontend talks to ---
# prod:  https://api.beachrex.com
# uat:   https://uat-api.beachrex.com
# dev:   https://dev-api.beachrex.com
NEXT_PUBLIC_API_ENDPOINT=https://api.beachrex.com

# --- Canonical base URL (SEO, sitemaps, canonical links) ---
# prod:  https://beachrex.com
# uat:   https://uat.beachrex.com
# dev:   https://dev.beachrex.com
NEXT_PUBLIC_BASE_URL=https://beachrex.com

# --- CDN endpoints (DigitalOcean Spaces + Imagor) — same across envs ---
NEXT_PUBLIC_CDN_TEASER=https://s3.beachrex.com/unsafe/fit-in/800x800/
NEXT_PUBLIC_CDN_LARGE=https://s3.beachrex.com/unsafe/fit-in/2800x2800/
NEXT_PUBLIC_CDN_ASSETS=https://beachrex.fra1.digitaloceanspaces.com/public/

# --- Node runtime ---
NODE_ENV=production
PORT=3001
# prod: 3001 | uat: 3002 | dev: 3003
