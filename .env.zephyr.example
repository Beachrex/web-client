# Zephyr Scale Configuration
# Copy this file to .env.local and fill in your actual values

# Your Jira Project Key (e.g., QA, TEST, BEACH)
# Find this in your Jira project URL: https://yourdomain.atlassian.net/jira/software/projects/QA
ZEPHYR_PROJECT_KEY=YOUR_PROJECT_KEY

# Zephyr Scale API Token
# Generate this from: Jira Settings > Apps > Zephyr Scale API Access Tokens
# Or from: https://yourdomain.atlassian.net/plugins/servlet/ac/com.kanoah.test-manager/api-access-tokens
ZEPHYR_AUTH_TOKEN=your_zephyr_api_token_here

